{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "command": "python3 .cursor/hooks/deny_subagent.py",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/guard_shell.py",
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "python3 .cursor/hooks/protect_secrets.py",
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/verify_on_stop.py",
        "loop_limit": 1
      }
    ]
  }
}
