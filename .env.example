# Copy this file to .env in the folder you start the app from, then fill in your own values.
# Every role (Organizer, Administrator, Attendee) must use the same database.
DATABASE_URL=jdbc:postgresql://localhost:5432/event_manager
DATABASE_USER=your_postgres_username
DATABASE_PASSWORD=
EVENT_MANAGER_DB_URL=jdbc:postgresql://localhost:5432/event_manager
EVENT_MANAGER_DB_USER=your_postgres_username
EVENT_MANAGER_DB_PASSWORD=
